# Supabase Production & Staging Environment Credentials
# Copy this template to .env.local and populate with your project's credentials.
# NEVER commit .env.local to Git version control.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: Service Role Key (Server-Only, for admin user provisioning)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
